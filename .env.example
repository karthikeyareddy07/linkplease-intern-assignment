# PseudoGram Mock API Key (Obtained via /v1/apply & /v1/keygen)
PSEUDOGRAM_API_KEY=your_pseudogram_api_key_here

# Mock API Base URL
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# Database URL or SQLite path
DATABASE_PATH=linkplease.db

# Server Port
PORT=8000

# Worker Settings
WORKER_POLL_INTERVAL_SECONDS=0.5
MAX_RETRIES=5
RECONCILIATION_INTERVAL_SECONDS=2.0

# Strict Rate Limiter Settings (Mock API allows 10 reqs per rolling 60s)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60.0
